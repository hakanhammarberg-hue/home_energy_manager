From 34d4fb4f9367098e969054cdf4003dcccb6e9090 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 17:01:28 +0000
Subject: [PATCH] Add real Zaptec Go 2 device photo, replacing the generic Zap
 icon
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Håkan sent a photo of his own Zaptec Go 2 charger (confirmed his own,
same provenance check as the original six device photos from
2026-10-03). The compact tile now shows the real unit like every other
tile instead of a generic lucide icon.
---
 home_energy_manager/config.yaml                  |   2 +-
 .../frontend/src/assets/devices/zaptec.jpg       | Bin 0 -> 9552 bytes
 .../frontend/src/components/CompactStatusRow.tsx |  12 +++++++-----
 3 files changed, 8 insertions(+), 6 deletions(-)
 create mode 100644 home_energy_manager/frontend/src/assets/devices/zaptec.jpg

diff --git a/home_energy_manager/config.yaml b/home_energy_manager/config.yaml
index 88830cb..6c975d9 100644
--- a/home_energy_manager/config.yaml
+++ b/home_energy_manager/config.yaml
@@ -1,6 +1,6 @@
 name: "H.E.M. - Hammarberg Energy Manager"
 description: "Battery, EV charging, heat pump and peak-power management (fork of BESS Manager)"
-version: "0.1.21"
+version: "0.1.22"
 slug: "home_energy_manager"
 # No 'image' key, unlike upstream's ghcr.io/johanzander/bess-manager-{arch} —
 # there's no registry to publish this fork's image to, so the Supervisor
diff --git a/home_energy_manager/frontend/src/assets/devices/zaptec.jpg b/home_energy_manager/frontend/src/assets/devices/zaptec.jpg
new file mode 100644
index 0000000000000000000000000000000000000000..b9f1e4b80657490f1fe4a2065a673c76d76ac968
GIT binary patch
