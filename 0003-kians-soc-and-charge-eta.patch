+  const evValue =
+    ev.evSocPercent !== null ? `${ev.evSocPercent.toFixed(0)}%` : evEnabled ? evStatus : '—';
+  const evEtaLabel = formatChargeEta(ev.chargingActive, ev.estimatedChargeDurationMin);
