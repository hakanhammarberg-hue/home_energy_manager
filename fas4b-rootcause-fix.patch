 .../frontend/assets/main-B9fa0AUY.css         |   1 -
 .../frontend/assets/main-Cn4ecN0M.js          | 302 ------------------
 .../frontend/assets/vendor-c5ypKtDW.js        |  17 -
 3 files changed, 320 deletions(-)
 delete mode 100644 home_energy_manager/frontend/assets/main-B9fa0AUY.css
 delete mode 100644 home_energy_manager/frontend/assets/main-Cn4ecN0M.js
 delete mode 100644 home_energy_manager/frontend/assets/vendor-c5ypKtDW.js

diff --git a/home_energy_manager/frontend/assets/main-B9fa0AUY.css b/home_energy_manager/frontend/assets/main-B9fa0AUY.css
deleted file mode 100644
index 2af8a55..0000000
--- a/home_energy_manager/frontend/assets/main-B9fa0AUY.css
+++ /dev/null
