     enabled,
+    evSocPercent,
     socCapPercent,
     overrideRequested,
     status,
@@ -86,6 +87,11 @@ export default function EvSchedulerStatusCard() {
             : undefined
       }
       metrics={[
+        {
+          label: 'SOC (nu)',
