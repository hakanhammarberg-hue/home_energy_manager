+          unit: '%',
+        },
         {
           label: 'SOC-tak',
           value: socCapPercent !== null ? socCapPercent.toFixed(0) : '—',
diff --git a/home_energy_manager/frontend/src/hooks/useEvSchedulerStatus.ts b/home_energy_manager/frontend/src/hooks/useEvSchedulerStatus.ts
index 3b6f291..592086e 100644
--- a/home_energy_manager/frontend/src/hooks/useEvSchedulerStatus.ts
