From caf5fea15a59f8ccbe2fe85717c94e9577507a5c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 3 Oct 2026 17:41:11 +0000
Subject: [PATCH] Add device photo gallery to the dashboard
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Håkan's own photos of his installed solar panels, battery, Growatt
inverter, Nibe F750 heat pump, EV, and Zaptec charger — a new "Mina
enheter" section at the top of the dashboard, right under the header
(which already carries his house photo). Confirmed by Håkan that all
six are genuinely his own equipment despite the studio-style white
backgrounds.
---
 home_energy_manager/config.yaml               |   2 +-
 .../frontend/src/assets/devices/battery.jpg   | Bin 0 -> 3803 bytes
 .../src/assets/devices/ev-charger.jpg         | Bin 0 -> 9422 bytes
 .../frontend/src/assets/devices/ev.jpg        | Bin 0 -> 25111 bytes
 .../frontend/src/assets/devices/heat-pump.jpg | Bin 0 -> 9897 bytes
 .../frontend/src/assets/devices/inverter.jpg  | Bin 0 -> 9938 bytes
 .../src/assets/devices/solar-panels.jpg       | Bin 0 -> 27091 bytes
 .../frontend/src/components/DeviceGallery.tsx |  60 ++++++++++++++++++
 .../frontend/src/pages/DashboardPage.tsx      |  13 ++++
 9 files changed, 74 insertions(+), 1 deletion(-)
 create mode 100644 home_energy_manager/frontend/src/assets/devices/battery.jpg
 create mode 100644 home_energy_manager/frontend/src/assets/devices/ev-charger.jpg
 create mode 100644 home_energy_manager/frontend/src/assets/devices/ev.jpg
 create mode 100644 home_energy_manager/frontend/src/assets/devices/heat-pump.jpg
 create mode 100644 home_energy_manager/frontend/src/assets/devices/inverter.jpg
 create mode 100644 home_energy_manager/frontend/src/assets/devices/solar-panels.jpg
 create mode 100644 home_energy_manager/frontend/src/components/DeviceGallery.tsx

diff --git a/home_energy_manager/config.yaml b/home_energy_manager/config.yaml
index 82862a2..c10d0ce 100644
--- a/home_energy_manager/config.yaml
+++ b/home_energy_manager/config.yaml
@@ -1,6 +1,6 @@
 name: "H.E.M. - Hammarberg Energy Manager"
 description: "Battery, EV charging, heat pump and peak-power management (fork of BESS Manager)"
-version: "0.1.18"
+version: "0.1.19"
 slug: "home_energy_manager"
 # No 'image' key, unlike upstream's ghcr.io/johanzander/bess-manager-{arch} —
 # there's no registry to publish this fork's image to, so the Supervisor
diff --git a/home_energy_manager/frontend/src/assets/devices/battery.jpg b/home_energy_manager/frontend/src/assets/devices/battery.jpg
new file mode 100644
index 0000000000000000000000000000000000000000..10bcde0a812363c06d536b0d2a1def6bd0401f98
